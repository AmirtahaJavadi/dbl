SELECT * FROM SalesLT.Customer 
where FirstName LIKE '%[abcdef]'
OR LastName LIKE '%[abcdef]'


select a.City ,count(*) as count FROM SalesLT.CustomerAddress c
join SalesLT.Address a ON c.AddressID = a.AddressID
GROUP BY a.City
order by count desc


select soh.SalesOrderID , soh.OrderDate ,count(*) from SalesLT.SalesOrderDetail sod
join SalesLT.SalesOrderHeader soh on soh.SalesOrderID = sod.SalesOrderID
group by soh.SalesOrderID , soh.OrderDate 
